# Port the HTTP server listens on.
PORT=3000

# Where the service thinks it is running: development | production
NODE_ENV=development

# Upstream data sources. Neither needs a key. Override to point at a mirror,
# a snapshot, or a stub during testing.
GRAPH_BASE_URL=https://data.busrouter.sg/v1/
ARRIVALS_URL=https://arrivelah2.busrouter.sg/

# Arrival cache lifetime. arrivelah2 sends Cache-Control: max-age=15, so caching
# for less than this adds upstream load without returning fresher data.
ARRIVALS_TTL_MS=15000

# How often to re-download the stop and route graph.
GRAPH_REFRESH_MS=86400000

# Timeout applied to both upstreams.
UPSTREAM_TIMEOUT_MS=8000
